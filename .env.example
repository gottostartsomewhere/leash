# Copy to .env and fill in. Nothing here is required: with no credentials the
# app runs on a deterministic offline gateway and the offline adversary, which
# is what makes the whole thing developable and testable without an account.

# PayPal Payouts. Without these the gateway is simulated.
LEASH_PAYPAL_CLIENT_ID=
LEASH_PAYPAL_SECRET=
LEASH_PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Points every seeded payee at one address, so a single variable makes the
# demo pay into a real sandbox personal account.
LEASH_DEMO_RECEIVER_EMAIL=

# Groq, for the LLM adversary in scripts/redteam.py --llm. Without a key the
# red team runs the deterministic strategy adversary only.
LEASH_GROQ_API_KEY=
LEASH_GROQ_MODEL=llama-3.1-8b-instant
